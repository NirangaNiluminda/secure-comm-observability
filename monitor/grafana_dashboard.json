{
  "title": "Secure Traffic Overview",
  "schemaVersion": 27,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Packet Size Distribution",
      "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
          "query": "from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_traffic\" and r._field == \"size\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "bytes"
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SYN/ACK Ratio (DoS Detection)",
      "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
          "query": "from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_anomaly\" and r._field == \"syn_ack_ratio\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"syn_ack_ratio\")"
        },
        {
          "refId": "B",
          "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
          "query": "from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_anomaly\" and r._field == \"dos_suspected\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> yield(name: \"dos_suspected\")"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dos_suspected" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 50 },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Packets Captured",
      "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
          "query": "from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_traffic\" and r._field == \"size\")\n  |> count()\n  |> yield(name: \"count\")"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DoS Alerts",
      "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "afmazctoox1xcd" },
          "query": "from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_anomaly\" and r._field == \"dos_suspected\" and r._value == 1)\n  |> count()\n  |> yield(name: \"alerts\")"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } } }
    }
  ]
}
